build/
.DS_Store
__pycache__/
*.pyc
node_modules/

# Local extension signing keys stay outside tracked source.
*.pem

# Locally compiled Rust WebAssembly (reproducible from rust/optimizer_core.rs).
/optimizer_core.wasm

/optimizer_browser.wasm

/optimizer_history.wasm

/optimizer_queue.wasm

# Native release helper build output and generated lock until toolchain verification.
/Installers/native/target/
/Installers/native/Cargo.lock


# Native Mach-O launcher is produced locally on macOS; never track a generated executable.
/upload.app/Contents/MacOS/upload

# Generated browser WASM ABI loader (produced alongside the WASM binary).
/rust-browser-bindings.js

# Rust-generated browser API interoperability (not a handwritten source).
/utils.js
/history-viewer.js
/history-store.js
/rust-queue-bridge.js
/content.js
