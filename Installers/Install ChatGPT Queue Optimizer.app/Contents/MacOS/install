#!/bin/zsh
# Minimal Finder bootstrap; all installer policy and diagnostics live in Rust.
set -eu
export PATH="$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
repo="$(cd "$(dirname "$0")/../../../.." && pwd)"
if ! command -v cargo >/dev/null 2>&1; then
  /usr/bin/osascript -e 'display dialog "Install Rust from https://rustup.rs/ and rerun the installer." buttons {"OK"} default button "OK"'
  exit 1
fi
exec cargo run --release --manifest-path "$repo/Installers/native/Cargo.toml" -- install-auto --repo-dir "$repo" "$@"
