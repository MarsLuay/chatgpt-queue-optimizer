{
  "manifest_version": 3,
  "name": "ChatGPT Queue + Optimizer",
  "description": "Automate ChatGPT prompts with prompt chains, queues, and ChatGPT performance optimization.",
  "version": "1.0.0",
  "offline_enabled": true,

  "action": {
    "default_title": "ChatGPT Queue + Optimizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon_16.png",
      "48": "icon_48.png",
      "128": "icon_128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "options_page": "options.html",

  "commands": {
    "toggle-optimizer": {
      "description": "Toggle optimizer on/off",
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  },

  "content_scripts": [
    {
      "css": ["styles.css"],
      "js": ["content.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "run_at": "document_start"
    }
  ],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],

  "permissions": [
    "scripting",
    "storage",
    "activeTab",
    "tabs",
    "clipboardRead",
    "clipboardWrite"
  ],

  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "icon_16.png",
        "icon_48.png",
        "icon_128.png"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ]
}